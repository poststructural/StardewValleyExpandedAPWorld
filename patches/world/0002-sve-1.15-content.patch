diff --git a/worlds/stardew_valley/test/mods/TestSVE115Content.py b/worlds/stardew_valley/test/mods/TestSVE115Content.py
new file mode 100644
index 0000000..7ecbe78
--- /dev/null
+++ b/worlds/stardew_valley/test/mods/TestSVE115Content.py
@@ -0,0 +1,138 @@
+"""Tests for the SVE 1.15 content added on top of the existing sanity options (ids 90001+ in the csv files)."""
+from ..assertion import WorldAssertMixin
+from ..bases import SVTestCase, solo_multiworld
+from ..options.presets import maxsanity_no_mods_7_x_x
+from ... import options
+from ...locations import location_table, LocationTags
+from ...mods.mod_data import ModNames
+
+FIRST_NEW_ID = 90001
+
+NEW_LOCATIONS = [location for location in location_table.values()
+                 if location.code_without_offset is not None and location.code_without_offset >= FIRST_NEW_ID]
+
+# category -> (tag selecting the new locations, option overrides that turn it on)
+CATEGORIES = {
+    "fishsanity": (LocationTags.FISHSANITY, {options.Fishsanity.internal_name: options.Fishsanity.option_all}),
+    "cropsanity": (LocationTags.CROPSANITY, {options.Cropsanity.internal_name: options.Cropsanity.option_enabled}),
+    "cooksanity": (LocationTags.COOKSANITY, {options.Cooksanity.internal_name: options.Cooksanity.option_all}),
+    "chefsanity": (LocationTags.CHEFSANITY, {options.Chefsanity.internal_name: options.Chefsanity.preset_all}),
+    "craftsanity": (LocationTags.CRAFTSANITY, {options.Craftsanity.internal_name: options.Craftsanity.option_all}),
+    "friendsanity": (LocationTags.FRIENDSANITY, {options.Friendsanity.internal_name: options.Friendsanity.option_all_with_marriage,
+                                                 options.FriendsanityHeartSize.internal_name: 1}),
+    "museumsanity": (LocationTags.MUSEUM_MODDED_DONATIONS, {options.Museumsanity.internal_name: options.Museumsanity.option_all}),
+    "shipsanity": (LocationTags.SHIPSANITY, {options.Shipsanity.internal_name: options.Shipsanity.option_everything}),
+    "eatsanity": (LocationTags.EATSANITY, {options.Eatsanity.internal_name: options.Eatsanity.preset_all}),
+}
+
+
+def new_locations_with_tag(tag: LocationTags):
+    return [location for location in NEW_LOCATIONS if tag in location.tags]
+
+
+def minimal_options():
+    world_options = maxsanity_no_mods_7_x_x()
+    # Everything off, then each test turns on exactly one category.
+    world_options.update({
+        options.Fishsanity.internal_name: options.Fishsanity.option_none,
+        options.Cropsanity.internal_name: options.Cropsanity.option_disabled,
+        options.Cooksanity.internal_name: options.Cooksanity.option_none,
+        options.Chefsanity.internal_name: options.Chefsanity.preset_none,
+        options.Craftsanity.internal_name: options.Craftsanity.option_none,
+        options.Friendsanity.internal_name: options.Friendsanity.option_none,
+        options.Museumsanity.internal_name: options.Museumsanity.option_none,
+        options.Shipsanity.internal_name: options.Shipsanity.option_none,
+        options.Eatsanity.internal_name: options.Eatsanity.preset_none,
+        options.Goal.internal_name: options.Goal.option_community_center,
+    })
+    return world_options
+
+
+def location_names(multiworld) -> set[str]:
+    return {location.name for location in multiworld.get_locations(1)}
+
+
+class TestSVE115LocationsPerCategory(SVTestCase):
+
+    def test_new_locations_exist_in_the_table(self):
+        self.assertEqual(FIRST_NEW_ID, min(location.code_without_offset for location in NEW_LOCATIONS))
+        ids = sorted(location.code_without_offset for location in NEW_LOCATIONS)
+        self.assertEqual(list(range(ids[0], ids[0] + len(ids))), ids, "The new location ids should be a contiguous block")
+        for location in NEW_LOCATIONS:
+            self.assertIn(ModNames.sve, location.content_packs, location.name)
+
+    def test_each_category_has_locations_with_sve_and_none_without(self):
+        for category, (tag, category_options) in CATEGORIES.items():
+            expected = [location for location in new_locations_with_tag(tag)]
+            self.assertTrue(expected, f"{category} has no new locations")
+
+            with_sve = minimal_options()
+            with_sve.update(category_options)
+            with_sve[options.Mods.internal_name] = frozenset({ModNames.sve})
+            with_sve[options.ExcludeGingerIsland.internal_name] = options.ExcludeGingerIsland.option_false
+
+            without_sve = dict(with_sve)
+            without_sve[options.Mods.internal_name] = frozenset()
+
+            with self.subTest(category=category, sve=True):
+                with solo_multiworld(with_sve) as (multiworld, _):
+                    names = location_names(multiworld)
+                    missing = [location.name for location in expected if location.name not in names]
+                    # Friendship hearts above what the datable allows and options-dependent rows are the only legit absences.
+                    allowed_missing = [name for name in missing if self._legitimately_absent(category, name)]
+                    self.assertEqual(sorted(allowed_missing), sorted(missing), f"{category}: unexpected missing locations")
+                    self.assertGreater(len(expected) - len(missing), 0, category)
+
+            with self.subTest(category=category, sve=False):
