diff --git a/StardewArchipelago/Locations/CodeInjections/Modded/SVE/SVEEventGates.cs b/StardewArchipelago/Locations/CodeInjections/Modded/SVE/SVEEventGates.cs
new file mode 100644
index 0000000..82248be
--- /dev/null
+++ b/StardewArchipelago/Locations/CodeInjections/Modded/SVE/SVEEventGates.cs
@@ -0,0 +1,208 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using KaitoKid.Utilities.Interfaces;
+using StardewModdingAPI;
+using StardewModdingAPI.Events;
+using StardewValley;
+
+namespace StardewArchipelago.Locations.CodeInjections.Modded.SVE
+{
+    // Decides which Stardew Valley Expanded events may run naturally in an Archipelago game.
+    // Rules are keyed by event id, so they survive SVE changing the rest of the event key.
+    public static class SVEEventGates
+    {
+        public enum GateKind
+        {
+            // The event never runs naturally. The matching AP item marks it as seen instead.
+            Block,
+
+            // The event runs only once the AP mail flag exists. Named preconditions are ignored.
+            Gate,
+
+            // The event runs as normal, except the listed preconditions are ignored.
+            Relax,
+        }
+
+        public class EventGateRule
+        {
+            public string EventId { get; }
+            public GateKind Kind { get; }
+            public string RequiredMail { get; }
+            public HashSet<string> RelaxedNames { get; }
+            public HashSet<string> RelaxedExact { get; }
+            public string Reason { get; }
+
+            public EventGateRule(string eventId, GateKind kind, string reason, string requiredMail = null, string[] relaxedNames = null, string[] relaxedExact = null)
+            {
+                EventId = eventId;
+                Kind = kind;
+                Reason = reason;
+                RequiredMail = requiredMail;
+                RelaxedNames = new HashSet<string>(relaxedNames ?? Array.Empty<string>());
+                RelaxedExact = new HashSet<string>(relaxedExact ?? Array.Empty<string>());
+            }
+
+            public bool HasRelaxations => RelaxedNames.Any() || RelaxedExact.Any();
+
+            public bool IsRelaxed(string precondition)
+            {
+                var trimmed = precondition.Trim();
+                if (RelaxedExact.Contains(trimmed))
+                {
+                    return true;
+                }
+
+                var name = trimmed.Split(' ')[0].TrimStart('!');
+                return RelaxedNames.Contains(name);
+            }
+        }
+
+        public const string AURORA_TABLET_FLAG = "apAuroraVineyard";
+        public const string MORGAN_SCHOOLING_FLAG = "apMorganSchooling";
+
+        // The one place that lists every SVE event the integration controls.
+        public static readonly EventGateRule[] Rules =
+        {
+            // Apples' dream (start of the Aurora Vineyard chain): needs the tablet, not the Community Center or day 138.
+            new("77759254", GateKind.Gate, "Aurora Vineyard Tablet", AURORA_TABLET_FLAG, new[] { "e", "SeenEvent", "j", "DaysPlayed" }),
+
+            // Morgan's arrival: needs Morgan's Schooling, not year 3 / day of week / the Shrine of Illusions.
+            new("5978924", GateKind.Gate, "Morgan's Schooling", MORGAN_SCHOOLING_FLAG, new[] { "y", "Year", "d", "DayOfWeek", "e", "SeenEvent" }),
+
+            // Krobus ten hearts: the Dwarf sewer event is not guaranteed in AP.
+            new("1090505", GateKind.Relax, "Krobus without the Dwarf sewer event", relaxedExact: new[] { "e 691039" }),
+
+            new("3691371", GateKind.Block, "Scarlett's Job Offer"),
+            new("69069247", GateKind.Block, "Kittyfish Spell"),
+            new("65360191", GateKind.Block, "Fable Reef Portal"),
+            new("908070", GateKind.Block, "Nexus chain"),
+            new("908071", GateKind.Block, "Nexus chain"),
+            new("908072", GateKind.Block, "Nexus chain"),
+            new("908073", GateKind.Block, "Nexus chain"),
+            new("908074", GateKind.Block, "Nexus chain"),
+            new("908075", GateKind.Block, "Nexus chain"),
+            new("908076", GateKind.Block, "Nexus chain"),
+            new("908077", GateKind.Block, "Nexus chain"),
+            new("908078", GateKind.Block, "Nexus chain"),
+            new("1090501", GateKind.Block, "Rusty Key cutscene"),
+            new("1579125", GateKind.Block, "Marlon in the sewer (pre-marked at new game)"),
+        };
+
+        private static readonly Dictionary<string, EventGateRule> _rulesById = Rules.ToDictionary(x => x.EventId);
+        private static ILogger _logger;
+        private static bool _selfCheckPending;
+
+        public static void Initialize(ILogger logger)
+        {
+            _logger = logger;
+        }
+
+        public static void ScheduleStartupSelfCheck(IModHelper modHelper)
+        {
+            _selfCheckPending = true;
+            modHelper.Events.GameLoop.DayStarted += OnDayStarted_SelfCheck;
+        }
+
+        private static void OnDayStarted_SelfCheck(object sender, DayStartedEventArgs e)
+        {
+            if (!_selfCheckPending)
+            {
+                return;
+            }
+
+            _selfCheckPending = false;
+            try
+            {
+                SelfCheck();
+            }
+            catch (Exception ex)
+            {
+                _logger.LogError($"Failed in {nameof(SVEEventGates)}.{nameof(SelfCheck)}:\n{ex}");
+            }
+        }
+
+        private static void SelfCheck()
+        {
+            var foundIds = new HashSet<string>();
+            foreach (var location in Game1.locations)
+            {
+                if (!location.TryGetLocationEvents(out _, out var events) || events == null)
+                {
+                    continue;
+                }
+
+                foreach (var key in events.Keys)
+                {
+                    var id = key.Split('/')[0];
+                    if (_rulesById.ContainsKey(id))
+                    {
+                        foundIds.Add(id);
+                    }
+                }
+            }
+
+            foreach (var rule in Rules.Where(x => !foundIds.Contains(x.EventId)))
+            {
+                _logger.LogWarning($"SVE event gate for event {rule.EventId} ({rule.Reason}) matches no event in any location's Data/Events. SVE may have renumbered it.");
+            }
+
+            _logger.LogInfo($"SVE event gates: {foundIds.Count} of {Rules.Length} rules bound to a live event.");
+        }
+
+        // public virtual string checkEventPrecondition(string precondition, bool check_seen)
+        public static bool CheckEventPrecondition_GateApControlledEvents_Prefix(GameLocation __instance, string precondition, bool check_seen, ref string __result)
+        {
+            try
+            {
+                var parts = Event.SplitPreconditions(precondition);
+                if (parts == null || parts.Length == 0 || !_rulesById.TryGetValue(parts[0], out var rule))
+                {
+                    return true;
+                }
+
+                var id = parts[0];
+                if (rule.Kind == GateKind.Block ||
+                    (rule.RequiredMail != null && !Game1.player.mailReceived.Contains(rule.RequiredMail)))
+                {
+                    __result = "-1";
+                    return false;
+                }
+
+                if (!rule.HasRelaxations)
+                {
+                    return true;
+                }
+
+                if (check_seen && (Game1.player.eventsSeen.Contains(id) || Game1.eventsSeenSinceLastLocationChange.Contains(id)))
+                {
+                    __result = "-1";
+                    return false;
+                }
+
+                for (var i = 1; i < parts.Length; i++)
+                {
+                    if (string.IsNullOrEmpty(parts[i]) || rule.IsRelaxed(parts[i]))
+                    {
+                        continue;
+                    }
+
+                    // Still goes through the patched Event.CheckPrecondition, so the villager existence gate keeps working.
+                    if (!Event.CheckPrecondition(__instance, id, parts[i]))
+                    {
+                        __result = "-1";
+                        return false;
+                    }
+                }
+
+                __result = id;
+                return false;
+            }
+            catch (Exception ex)
+            {
+                _logger.LogError($"Failed in {nameof(CheckEventPrecondition_GateApControlledEvents_Prefix)}:\n{ex}");
+                return true;
+            }
+        }
+    }
+}
