diff --git a/StardewArchipelago/Coop/ItemScopes.cs b/StardewArchipelago/Coop/ItemScopes.cs
new file mode 100644
index 0000000..0ce7b20
--- /dev/null
+++ b/StardewArchipelago/Coop/ItemScopes.cs
@@ -0,0 +1,123 @@
+﻿using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json;
+using StardewArchipelago.Constants;
+using StardewArchipelago.Items.Unlocks.Vanilla;
+using StardewModdingAPI;
+using StardewValley;
+
+namespace StardewArchipelago.Coop
+{
+    /// <summary>Who applies a received Archipelago item in a co-op game.</summary>
+    public enum ItemScope
+    {
+        /// <summary>Applied once, by the host only: money, physical items, traps, world unlocks.</summary>
+        Team,
+
+        /// <summary>Applied by every farmer on its own game, to its own Farmer: backpack, tools, recipes, skills, flags...</summary>
+        PerFarmer,
+    }
+
+    /// <summary>
+    /// The co-op item scope table (phase C2). <see cref="Items.ItemParser.GetScope"/> classifies an item by the same rules the
+    /// parser uses to turn it into a letter, without running any handler; the exceptions to those rules live here.
+    ///
+    ///   Team      traps; money and resource packs; physical items (single items, stardrop, real books); the unlocks listed
+    ///             in <see cref="TeamUnlocks"/> (raccoon, Ginger Island, beach bridge, farm cave, babies, Pierre's stocklist,
+    ///             free cactis); info-only items not listed as per-farmer below (seasons, buildings, ...: their effect
+    ///             is read from the server item count on every client, only the letter is scoped).
+    ///   PerFarmer friendship bonus; enzymes; every other unlock (backpack, tools, scythe, rod, weapons, boots, slingshot,
+    ///             skills, masteries, keys/wallet items, power books, villager arrivals, CC/boat/SVE mail flags and events,
+    ///             spells, mod skills); cooking and crafting recipes; "X &lt;3" heart items; "... Bonus" player buffs.
+    /// </summary>
+    public static class ItemScopes
+    {
+        private static readonly HashSet<string> TeamUnlocks = new()
+        {
+            APItem.PROGRESSIVE_RACCOON,
+            VanillaUnlockManager.BEACH_BRIDGE,
+            VanillaUnlockManager.FRUIT_BATS,
+            VanillaUnlockManager.MUSHROOM_BOXES,
+            VanillaUnlockManager.PIERRE_STOCKLIST,
+            VanillaUnlockManager.FREE_CACTIS,
+            VanillaUnlockManager.ISLAND_MAILBOX,
+            VanillaUnlockManager.ISLAND_FARMHOUSE,
+            VanillaUnlockManager.TREEHOUSE,
+            "Island North Turtle",
+            "Island West Turtle",
+            "Dig Site Bridge",
+            "Island Trader",
+            "Island Resort",
+            "Farm Obelisk",
+            "Parrot Express",
+            "Volcano Bridge",
+            "Volcano Exit Shortcut",
+            "Open Professor Snail Cave",
+            "Ugly Baby",
+            "Cute Baby",
+            APItem.STARDROP,
+        };
+
+        private const string REAL_BOOK_PREFIX = "Book: ";
+
+        public static ItemScope ForUnlock(string itemName)
+        {
+            return TeamUnlocks.Contains(itemName) || itemName.StartsWith(REAL_BOOK_PREFIX) ? ItemScope.Team : ItemScope.PerFarmer;
+        }
+
+        public static ItemScope ForInformationOnly(string itemName)
+        {
+            return itemName.EndsWith(" <3") || itemName.EndsWith(" Bonus") ? ItemScope.PerFarmer : ItemScope.Team;
+        }
+    }
+
+    /// <summary>Per-farmer co-op data, kept in <see cref="Farmer.modData"/>: synced to the host and saved with the host's save.</summary>
+    public static class FarmerCoopData
+    {
+        private const string PREFIX = "KaitoKid.StardewArchipelago/";
+        public const string ITEMS_APPLIED_KEY = PREFIX + "ItemsAppliedUpTo";
+        public const string AP_EXPERIENCE_KEY = PREFIX + "ApExperience";
+        public const string AP_FRIENDSHIP_KEY = PREFIX + "ApFriendship";
+
+        /// <summary>Index of the first received item this farmer has not applied yet (items 0..N-1 are applied).</summary>
+        public static int GetItemsAppliedUpTo(Farmer farmer)
+        {
+            return farmer.modData.TryGetValue(ITEMS_APPLIED_KEY, out var value) && int.TryParse(value, out var cursor) ? cursor : 0;
+        }
+
+        public static void SetItemsAppliedUpTo(Farmer farmer, int cursor)
+        {
+            farmer.modData[ITEMS_APPLIED_KEY] = cursor.ToString();
+        }
+
+        public static T Read<T>(Farmer farmer, string key) where T : class
+        {
+            return farmer.modData.TryGetValue(key, out var json) && !string.IsNullOrWhiteSpace(json) ? JsonConvert.DeserializeObject<T>(json) : null;
+        }
+
+        public static void Write<T>(Farmer farmer, string key, T value)
+        {
+            farmer.modData[key] = JsonConvert.SerializeObject(value);
+        }
+    }
+
+    public static class CoopContext
+    {
+        /// <summary>True only for a non-host player in a multiplayer game. Always false in single-player.</summary>
+        public static bool IsFarmhand => Context.IsMultiplayer && !Context.IsMainPlayer;
+
+        /// <summary>
+        /// True when the save has more than one farmer. Personal effects then go to the local farmer only, because every other
+        /// farmer applies them on its own game (writes to a remote farmer's fields do not sync). False in a one-farmer save,
+        /// where behaviour is unchanged.
+        /// </summary>
+        public static bool PerFarmerEffects => Context.IsMultiplayer || Game1.getAllFarmers().Skip(1).Any();
+
+        /// <summary>The farmers a personal effect is written to on this game.</summary>
+        public static IEnumerable<Farmer> FarmersToAffect()
+        {
+            return PerFarmerEffects ? new[] { Game1.player } : Game1.getAllFarmers();
+        }
+    }
+}
