+        /// <summary>
+        /// Co-op scope of a received item, decided by the same rules as <see cref="ProcessItemAsLetter"/> in the same order,
+        /// without running any handler (handlers can have side effects). Exceptions are in <see cref="ItemScopes"/>.
+        /// </summary>
+        public ItemScope GetScope(string itemName)
+        {
+            if (TryParseResourcePack(itemName, out _, out _))
+            {
+                return ItemScope.Team; // money and resource packs: one copy for the farm
+            }
+
+            if (TryParseFriendshipBonus(itemName, out _) || itemName.EndsWith(" Enzyme"))
+            {
+                return ItemScope.PerFarmer;
+            }
+
+            if (_trapManager.IsTrap(itemName))
+            {
+                return ItemScope.Team;
+            }
+
+            if (_unlockManager.IsUnlock(itemName))
+            {
+                return ItemScopes.ForUnlock(itemName);
+            }
+
+            if (itemName.EndsWith(RECIPE_SUFFIX))
+            {
+                return ItemScope.PerFarmer;
+            }
+
+            if (_itemManager.ItemExists(_nameMapper.GetInternalName(itemName)))
+            {
+                return ItemScope.Team; // a physical item: one copy for the farm
+            }
+
+            return ItemScopes.ForInformationOnly(itemName);
+        }
