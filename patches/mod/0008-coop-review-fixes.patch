+        /// <summary>Marks every untagged tool in the local farmer's inventory as theirs. Tags are never moved to another farmer.</summary>
+        public static void TagLocalPlayerTools()
+        {
+            var owner = Game1.player.UniqueMultiplayerID.ToString();
+            foreach (var item in Game1.player.Items)
+            {
+                if (item is Tool tool && !tool.modData.ContainsKey(TOOL_OWNER_KEY))
